{
  "name": "dsh-usage-hub",
  "version": "0.5.0",
  "private": true,
  "description": "Aggregated subscription usage in the DeepSeek Harness composer dock: DeepSeek API balance and OpenCode Go allowance.",
  "type": "module",
  "license": "MIT",
  "author": "Blackout",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blkot/dsh-usage-hub.git"
  },
  "homepage": "https://github.com/blkot/dsh-usage-hub#readme",
  "bugs": {
    "url": "https://github.com/blkot/dsh-usage-hub/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "usage",
    "limits",
    "opencode",
    "balance"
  ],
  "engines": {
    "dsh": ">=0.2.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
